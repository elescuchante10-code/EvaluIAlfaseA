# Backend (Coolify/Compose)
# Si cambias POSTGRES_PASSWORD, DATABASE_URL debe usar la misma contraseña.
POSTGRES_DB=evaluai
POSTGRES_USER=evaluai
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

DATABASE_URL=postgresql+psycopg://evaluai:CHANGE_ME_DB_PASSWORD@postgres:5432/evaluai
APP_ENV=production
# En producción, usa un SECRET_KEY largo (>=32 chars) y aleatorio.
SECRET_KEY=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME
DEBUG=False
FRONTEND_URL=https://tu-dominio.com
ALLOWED_ORIGINS=https://tu-dominio.com

# Build del frontend (misma URL que el navegador usará para llamar al API).
REACT_APP_API_URL=https://api.tu-dominio.com

# Puertos publicados (opcional; por defecto 8000 y 3000 en docker-compose.yml)
# BACKEND_PUBLISH_PORT=8000
# FRONTEND_PUBLISH_PORT=3000

# AI Providers
GROQ_API_KEY=

# Optional bootstrap admin
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Por seguridad: en producción el bootstrap admin está deshabilitado salvo que actives este flag.
ADMIN_BOOTSTRAP_ALLOW_IN_PROD=false

# Optional: Wompi
WOMPI_ENVIRONMENT=sandbox
WOMPI_PRIVATE_KEY=
WOMPI_PUBLIC_KEY=
WOMPI_EVENT_SECRET=
